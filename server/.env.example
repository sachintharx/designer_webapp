# Server Configuration
PORT=5000

# MongoDB Atlas connection string - REQUIRED
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname

# JWT secret for auth tokens - REQUIRED (use a strong random string)
JWT_SECRET=your-secure-random-secret-here

# Admin credentials - REQUIRED (change these!)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=YourSecurePassword123!

# Client origin for CORS - REQUIRED
# For production: set to your Netlify URL
# Support multiple origins separated by comma
# Example: https://your-site.netlify.app,http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173
